DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
SECRET_KEY=<your-secret-key>

REDIS_URL=redis://localhost:6379/0

UPLOAD_DIR=uploads

# Supabase Auth token verification.
SUPABASE_URL=https://your-project.supabase.co
# Set only when this project uses legacy shared-secret JWT signing.
# SUPABASE_JWT_SECRET=your-jwt-secret
APP_PUBLIC_URL=http://127.0.0.1:5173

# Invitation email (optional; without SMTP, invite links are shown for copying).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=your-sender@example.com

# Optional weekly digest email delivery (unset to persist digests without email).
# Configure DIGEST_SMTP_USERNAME and DIGEST_SMTP_PASSWORD together when authentication is required.
# DIGEST_SMTP_HOST=smtp.example.com
# DIGEST_SMTP_PORT=587
# DIGEST_SMTP_USERNAME=your-smtp-username
# DIGEST_SMTP_PASSWORD=your-smtp-password
# DIGEST_SMTP_STARTTLS=true
# DIGEST_EMAIL_FROM=reports@example.com
# WEEKLY_DIGEST_MODEL=claude-haiku-4-5-20251001
