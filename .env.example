DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
SECRET_KEY=<your-secret-key>

REDIS_URL=redis://localhost:6379/0

UPLOAD_DIR=uploads

# Optional weekly digest email delivery (unset to persist digests without email).
# Configure DIGEST_SMTP_USERNAME and DIGEST_SMTP_PASSWORD together when authentication is required.
# DIGEST_SMTP_HOST=smtp.example.com
# DIGEST_SMTP_PORT=587
# DIGEST_SMTP_USERNAME=your-smtp-username
# DIGEST_SMTP_PASSWORD=your-smtp-password
# DIGEST_SMTP_STARTTLS=true
# DIGEST_EMAIL_FROM=reports@example.com
# WEEKLY_DIGEST_MODEL=claude-haiku-4-5-20251001
